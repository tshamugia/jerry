{
  "name": "jerry",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tauri build",
    "build:ui": "vite build",
    "tauri": "tauri",
    "bindings": "cargo run --quiet -p jerry --example bindings",
    "lint": "biome check . && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "biome check --write . && cargo fmt --all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && cargo nextest run --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
